root = true
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
[*.{yml,yaml,json,md}]
indent_size = 2
[ironbridge/jcl/tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
end_of_line = unset
